{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "type-check": {
      "outputs": []
    },
    "lint": {
      "dependsOn": ["type-check"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["type-check", "^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^type-check"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^type-check"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:catalog:red": {
      "dependsOn": ["type-check"],
      "outputs": [],
      "cache": false
    },
    "test:web:red": {
      "outputs": [],
      "cache": false
    }
  }
}
