# Copy this file to `.env` and replace the placeholder with your real connection string.
# Pooled connection used by the application runtime.
DATABASE_URL="postgresql://user:password@pooler.example.com:6543/mydb?pgbouncer=true"

# Direct connection used only by Prisma CLI migrations and introspection.
DIRECT_URL="postgresql://user:password@db.example.com:5432/mydb"

# Public Supabase endpoint and publishable key. Never place a secret/service-role key here.
SUPABASE_URL="https://project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Existing private bucket expected by the media adapter. This application does not create it.
SUPABASE_STORAGE_BUCKET="product-media"

PORT="3001"
